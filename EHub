```react
import React, { useState, useEffect } from 'react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut } from 'firebase/auth';
import { getFirestore, collection, getDocs, addDoc, updateDoc, doc, getDoc, setDoc } from 'firebase/firestore';
import { getStorage, ref, uploadBytesResumable, getDownloadURL } from 'firebase/storage';

// Tomar Firebase Configuration
const firebaseConfig = {
  apiKey: "AIzaSyBxzTKy4vi9VcGFM7kg4pePDukB-aWhoAA",
  authDomain: "premium-hsc-notes.firebaseapp.com",
  projectId: "premium-hsc-notes",
  storageBucket: "premium-hsc-notes.firebasestorage.app",
  messagingSenderId: "938896449795",
  appId: "1:938896449795:web:73f7516e756df73aea0936"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const storage = getStorage(app);

export default function App() {
  const [activeTab, setActiveTab] = useState('store'); 
  const [products, setProducts] = useState([]);
  const [cart, setCart] = useState([]);
  const [loading, setLoading] = useState(true);
  
  // Admin states
  const [user, setUser] = useState(null);
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [orders, setOrders] = useState([]);
  const [settings, setSettings] = useState({ paymentNumber: '01XXXXXXXXX', couponCode: '', discountAmount: 0 });
  
  // Cart & Coupon
  const [inputCoupon, setInputCoupon] = useState('');
  const [discount, setDiscount] = useState(0);

  // New Product states
  const [newProduct, setNewProduct] = useState({ 
    title: '', bookName: '', authorName: '', description: '', price: '', category: 'Physics' 
  });
  const [demoFile, setDemoFile] = useState(null);
  const [mainFile, setMainFile] = useState(null);
  const [uploading, setUploading] = useState(false);

  const fetchProducts = async () => {
    setLoading(true);
    try {
      const querySnapshot = await getDocs(collection(db, "products"));
      const prods = querySnapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      setProducts(prods);
    } catch (error) {
      console.error("Error fetching products:", error);
    }
    setLoading(false);
  };

  const fetchSettings = async () => {
    try {
      const docSnap = await getDoc(doc(db, "settings", "global"));
      if (docSnap.exists()) {
        setSettings(docSnap.data());
      }
    } catch (error) {
      console.error("Error fetching settings:", error);
    }
  };

  useEffect(() => {
    fetchProducts();
    fetchSettings();
    const unsubscribe = onAuthStateChanged(auth, (currentUser) => {
      setUser(currentUser);
      if (currentUser) fetchOrders();
    });
    return () => unsubscribe();
  }, []);

  const fetchOrders = async () => {
    try {
      const querySnapshot = await getDocs(collection(db, "orders"));
      const ords = querySnapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      setOrders(ords);
    } catch (error) {
      console.error("Error fetching orders:", error);
    }
  };

  const handleLogin = async (e) => {
    e.preventDefault();
    try {
      await signInWithEmailAndPassword(auth, email, password);
      alert('Successfully logged in as Admin!');
    } catch (error) {
      alert('Login failed: ' + error.message);
    }
  };

  const handleLogout = () => signOut(auth);

  // PDF Upload & Add Product Logic
  const handleAddProduct = async (e) => {
    e.preventDefault();
    if (!mainFile) return alert("Please select a Main PDF file!");
    
    setUploading(true);
    try {
      let demoUrl = "";
      if (demoFile) {
        const demoRef = ref(storage, `demos/${Date.now()}_${demoFile.name}`);
        await uploadBytesResumable(demoRef, demoFile);
        demoUrl = await getDownloadURL(demoRef);
      }

      const mainRef = ref(storage, `pdfs/${Date.now()}_${mainFile.name}`);
      await uploadBytesResumable(mainRef, mainFile);
      const mainUrl = await getDownloadURL(mainRef);

      await addDoc(collection(db, "products"), {
        title: newProduct.title,
        bookName: newProduct.bookName,
        authorName: newProduct.authorName,
        description: newProduct.description,
        price: Number(newProduct.price) || 0, // 0 for Free
        category: newProduct.category,
        demoPdfUrl: demoUrl,
        mainPdfUrl: mainUrl
      });
      
      alert("Product added successfully!");
      setNewProduct({ title: '', bookName: '', authorName: '', description: '', price: '', category: 'Physics' });
      setDemoFile(null);
      setMainFile(null);
      fetchProducts();
    } catch (error) {
      alert("Error adding product: " + error.message);
    }
    setUploading(false);
  };

  // Update Settings
  const handleSaveSettings = async (e) => {
    e.preventDefault();
    try {
      await setDoc(doc(db, "settings", "global"), settings);
      alert("Settings updated!");
    } catch (error) {
      alert("Error updating settings: " + error.message);
    }
  };

  // Coupon Apply
  const applyCoupon = () => {
    if (inputCoupon === settings.couponCode && settings.couponCode !== '') {
      setDiscount(Number(settings.discountAmount));
      alert("Coupon applied successfully!");
    } else {
      alert("Invalid Coupon Code!");
      setDiscount(0);
    }
  };

  // Checkout (Orders)
  const handleCheckout = async (e) => {
    e.preventDefault();
    const phone = e.target.phone.value;
    const trxId = e.target.trxId.value;
    
    try {
      await addDoc(collection(db, "orders"), {
        phone,
        trxId,
        items: cart,
        totalPaid: cart.reduce((sum, item) => sum + item.price, 0) - discount,
        status: 'Pending',
        timestamp: new Date().toISOString()
      });
      alert('Order submitted successfully! Wait for admin approval.');
      setCart([]);
      setDiscount(0);
      setActiveTab('library');
    } catch (error) {
      alert('Error submitting order: ' + error.message);
    }
  };

  const handleApproveOrder = async (orderId) => {
    try {
      const orderRef = doc(db, "orders", orderId);
      await updateDoc(orderRef, { status: 'Approved' });
      alert('Order Approved!');
      fetchOrders();
    } catch (error) {
      alert('Error approving order: ' + error.message);
    }
  };

  // Direct Free PDF Claim
  const handleGetFree = (product) => {
    alert(`"${product.title}" added to your Library for FREE!`);
    // Real logic would push this directly to user's library collection without order approval
  };

  return (
    <div className="min-h-screen bg-gray-50 text-gray-800 font-sans">
      <nav className="bg-white shadow-sm p-4 flex justify-between items-center sticky top-0 z-50">
        <h1 className="text-xl font-bold text-green-600">HSC Solution Hub</h1>
        <div className="flex gap-4">
          <button onClick={() => setActiveTab('store')} className={`p-2 rounded ${activeTab === 'store' ? 'bg-green-100 text-green-700' : 'text-gray-600'}`}>
            🏠 Home
          </button>
          <button onClick={() => setActiveTab('library')} className={`p-2 rounded ${activeTab === 'library' ? 'bg-green-100 text-green-700' : 'text-gray-600'}`}>
            📚 Library
          </button>
          <button onClick={() => setActiveTab('cart')} className={`p-2 rounded ${activeTab === 'cart' ? 'bg-green-100 text-green-700' : 'text-gray-600'}`}>
            🛒 Cart ({cart.length})
          </button>
          <button onClick={() => setActiveTab('admin')} className={`p-2 rounded ${activeTab === 'admin' ? 'bg-gray-200 text-gray-800' : 'text-gray-400'}`}>
            🔒
          </button>
        </div>
      </nav>

      <main className="max-w-4xl mx-auto p-4 mt-6">
        {activeTab === 'store' && (
          <div>
            <h2 className="text-2xl font-bold mb-6 text-center">Premium HSC Notes</h2>
            {loading ? (
              <div className="text-center text-gray-500 py-10">Loading premium notes...</div>
            ) : products.length === 0 ? (
              <div className="text-center py-12 bg-white rounded shadow border border-gray-100">
                <p className="text-gray-500 mb-2">No notes available right now.</p>
              </div>
            ) : (
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {products.map(product => (
                  <div key={product.id} className="bg-white p-5 rounded-lg shadow-sm border border-gray-100 hover:shadow-md transition">
                    <span className="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded mb-2 inline-block">{product.category}</span>
                    <h3 className="font-bold text-lg">{product.title}</h3>
                    <p className="text-sm text-gray-600">Book: {product.bookName}</p>
                    <p className="text-sm text-gray-600 mb-2">Author: {product.authorName}</p>
                    <p className="text-xs text-gray-500 mb-4 h-12 overflow-hidden">{product.description}</p>
                    
                    <p className="text-xl font-bold text-gray-800 mb-4">
                      {product.price === 0 ? <span className="text-green-600">FREE</span> : `৳ ${product.price}`}
                    </p>
                    
                    <div className="flex gap-2">
                      {product.demoPdfUrl && (
                        <a href={product.demoPdfUrl} target="_blank" rel="noreferrer" className="flex-1 text-center bg-gray-200 text-gray-700 py-2 rounded font-semibold hover:bg-gray-300">
                          Demo
                        </a>
                      )}
                      {product.price === 0 ? (
                        <button onClick={() => handleGetFree(product)} className="flex-1 bg-green-500 text-white py-2 rounded font-semibold hover:bg-green-600">
                          Get for Free
                        </button>
                      ) : (
                        <button 
                          onClick={() => {
                            if(!cart.find(item => item.id === product.id)) {
                              setCart([...cart, product]);
                              alert('Added to cart!');
                            }
                          }}
                          className="flex-1 bg-green-500 text-white py-2 rounded font-semibold hover:bg-green-600"
                        >
                          Add to Cart
                        </button>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {activeTab === 'cart' && (
          <div className="bg-white p-6 rounded-lg shadow">
            <h2 className="text-2xl font-bold mb-4">Your Cart</h2>
            {cart.length === 0 ? (
              <p className="text-gray-500">Your cart is empty.</p>
            ) : (
              <div>
                <ul className="mb-4">
                  {cart.map(item => (
                    <li key={item.id} className="flex justify-between py-2 border-b">
                      <span>{item.title}</span>
                      <span className="font-bold">৳ {item.price}</span>
                    </li>
                  ))}
                </ul>

                {/* Coupon Code Section */}
                <div className="flex gap-2 mb-4 border-b pb-4">
                  <input type="text" placeholder="Coupon Code" value={inputCoupon} onChange={e => setInputCoupon(e.target.value)} className="border p-2 rounded flex-1" />
                  <button onClick={applyCoupon} className="bg-gray-800 text-white px-4 py-2 rounded font-bold">Apply</button>
                </div>

                <div className="font-bold text-xl mb-6 text-right">
                  {discount > 0 && <p className="text-sm text-green-600">Discount: -৳ {discount}</p>}
                  Total: ৳ {Math.max(0, cart.reduce((sum, item) => sum + item.price, 0) - discount)}
                </div>
                
                <div className="bg-green-50 p-4 rounded mb-6">
                  <p className="font-semibold text-green-800 mb-2">Payment Instructions:</p>
                  <p className="text-sm text-green-700 mb-1">1. Send money to bKash/Nagad: <strong>{settings.paymentNumber}</strong></p>
                  <p className="text-sm text-green-700">2. Enter your Phone and TrxID below to verify.</p>
                </div>

                <form onSubmit={handleCheckout} className="space-y-4">
                  <div>
                    <input name="phone" type="text" required className="w-full border p-2 rounded" placeholder="Your Phone Number" />
                  </div>
                  <div>
                    <input name="trxId" type="text" required className="w-full border p-2 rounded" placeholder="Transaction ID (TrxID)" />
                  </div>
                  <button type="submit" className="w-full bg-green-600 text-white font-bold py-3 rounded">Submit Order</button>
                </form>
              </div>
            )}
          </div>
        )}

        {activeTab === 'library' && (
          <div className="bg-white p-6 rounded-lg shadow">
            <h2 className="text-2xl font-bold mb-4">My Library</h2>
            <div className="bg-gray-100 p-10 text-center rounded border border-dashed border-gray-300">
               <span className="text-4xl block mb-2">📚</span>
               <p className="text-gray-500">Wait for admin approval to view DRM-protected PDFs here.</p>
            </div>
          </div>
        )}

        {activeTab === 'admin' && (
          <div className="bg-white p-6 rounded-lg shadow border-t-4 border-gray-800">
            <div className="flex justify-between items-center mb-6">
               <h2 className="text-2xl font-bold text-gray-800">Admin Dashboard</h2>
               {user && <button onClick={handleLogout} className="text-red-500 text-sm font-bold">Logout</button>}
            </div>

            {!user ? (
              <form onSubmit={handleLogin} className="space-y-4 max-w-sm mx-auto">
                <input type="email" value={email} onChange={e => setEmail(e.target.value)} placeholder="Admin Email" required className="w-full border p-2 rounded" />
                <input type="password" value={password} onChange={e => setPassword(e.target.value)} placeholder="Password" required className="w-full border p-2 rounded" />
                <button type="submit" className="w-full bg-gray-800 text-white font-bold py-2 rounded">Login</button>
              </form>
            ) : (
              <div className="space-y-8">
                
                {/* Add Product Section */}
                <div className="bg-gray-50 p-4 rounded border">
                  <h3 className="font-bold text-lg mb-4">Add New Product</h3>
                  <form onSubmit={handleAddProduct} className="space-y-4">
                    <div className="flex flex-col md:flex-row gap-4">
                      <input type="text" placeholder="Note Title" required value={newProduct.title} onChange={e => setNewProduct({...newProduct, title: e.target.value})} className="flex-1 border p-2 rounded" />
                      <input type="number" placeholder="Price (0 for Free)" required value={newProduct.price} onChange={e => setNewProduct({...newProduct, price: e.target.value})} className="w-full md:w-32 border p-2 rounded" />
                      <select value={newProduct.category} onChange={e => setNewProduct({...newProduct, category: e.target.value})} className="border p-2 rounded bg-white">
                        <option>Physics</option><option>Chemistry</option><option>Math</option>
                      </select>
                    </div>
                    <div className="flex flex-col md:flex-row gap-4">
                      <input type="text" placeholder="Book Name" required value={newProduct.bookName} onChange={e => setNewProduct({...newProduct, bookName: e.target.value})} className="flex-1 border p-2 rounded" />
                      <input type="text" placeholder="Author Name" required value={newProduct.authorName} onChange={e => setNewProduct({...newProduct, authorName: e.target.value})} className="flex-1 border p-2 rounded" />
                    </div>
                    <textarea placeholder="PDF Details & Description..." rows="2" value={newProduct.description} onChange={e => setNewProduct({...newProduct, description: e.target.value})} className="w-full border p-2 rounded"></textarea>
                    
                    <div className="flex flex-col md:flex-row gap-4 bg-white p-3 border rounded">
                      <div className="flex-1">
                        <label className="block text-xs font-bold mb-1 text-gray-600">Demo PDF (Optional)</label>
                        <input type="file" accept="application/pdf" onChange={e => setDemoFile(e.target.files[0])} className="w-full text-sm" />
                      </div>
                      <div className="flex-1">
                        <label className="block text-xs font-bold mb-1 text-red-600">Main PDF (Required)</label>
                        <input type="file" accept="application/pdf" required onChange={e => setMainFile(e.target.files[0])} className="w-full text-sm" />
                      </div>
                    </div>

                    <button type="submit" disabled={uploading} className="bg-green-600 text-white px-6 py-2 rounded font-bold w-full">
                      {uploading ? 'Uploading PDF & Saving...' : 'Add Note'}
                    </button>
                  </form>
                </div>

                {/* Settings Section */}
                <div className="bg-gray-50 p-4 rounded border">
                  <h3 className="font-bold text-lg mb-4">Store Settings</h3>
                  <form onSubmit={handleSaveSettings} className="flex flex-col md:flex-row gap-4 items-end">
                    <div className="flex-1">
                      <label className="block text-sm font-semibold mb-1">Bkash/Nagad Number</label>
                      <input type="text" value={settings.paymentNumber} onChange={e => setSettings({...settings, paymentNumber: e.target.value})} className="w-full border p-2 rounded" />
                    </div>
                    <div className="flex-1">
                      <label className="block text-sm font-semibold mb-1">Coupon Code</label>
                      <input type="text" value={settings.couponCode} onChange={e => setSettings({...settings, couponCode: e.target.value})} className="w-full border p-2 rounded" />
                    </div>
                    <div className="flex-1">
                      <label className="block text-sm font-semibold mb-1">Discount Amount (৳)</label>
                      <input type="number" value={settings.discountAmount} onChange={e => setSettings({...settings, discountAmount: e.target.value})} className="w-full border p-2 rounded" />
                    </div>
                    <button type="submit" className="bg-gray-800 text-white px-6 py-2 rounded font-bold h-[42px]">Save</button>
                  </form>
                </div>

                {/* Orders Section */}
                <div>
                  <h3 className="font-bold text-lg mb-4">Manage Orders</h3>
                  {orders.length === 0 ? <p className="text-sm text-gray-500">No orders yet.</p> : (
                    <div className="overflow-x-auto">
                      <table className="w-full text-left border-collapse">
                        <thead>
                          <tr className="bg-gray-100">
                            <th className="p-2 border-b">Phone</th>
                            <th className="p-2 border-b">TrxID</th>
                            <th className="p-2 border-b">Total</th>
                            <th className="p-2 border-b">Status</th>
                            <th className="p-2 border-b">Action</th>
                          </tr>
                        </thead>
                        <tbody>
                          {orders.map(order => (
                            <tr key={order.id} className="border-b">
                              <td className="p-2">{order.phone}</td>
                              <td className="p-2 font-mono text-sm">{order.trxId}</td>
                              <td className="p-2 text-sm">৳ {order.totalPaid}</td>
                              <td className="p-2">
                                <span className={`px-2 py-1 text-xs rounded font-bold ${order.status === 'Approved' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'}`}>
                                  {order.status}
                                </span>
                              </td>
                              <td className="p-2">
                                {order.status === 'Pending' && (
                                  <button onClick={() => handleApproveOrder(order.id)} className="bg-green-500 text-white px-3 py-1 text-sm rounded hover:bg-green-600">
                                    Approve
                                  </button>
                                )}
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>
        )}
      </main>
    </div>
  );
}
